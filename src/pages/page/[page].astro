---
import { getCollection } from 'astro:content';
import PostFeed from '../../components/PostFeed.astro';
import SiteRail from '../../components/SiteRail.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const postsPerPage = 6;
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const totalPages = Math.ceil(posts.length / postsPerPage);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    const start = (page - 1) * postsPerPage;
    return {
      params: { page: String(page) },
      props: { posts: posts.slice(start, start + postsPerPage), page, totalPages },
    };
  });
}

const { posts, page, totalPages } = Astro.props;
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout title={`第 ${page} 页 | Fatelessone 的博客`} description="博客文章归档。">
  <div class="home-grid archive-grid">
    <section class="home-content archive-page">
      <header class="page-intro">
        <p class="eyebrow">ARCHIVE</p>
        <h1>全部文章</h1>
        <p>按时间排列的个人写作存档。</p>
      </header>
      <PostFeed posts={posts} page={page} totalPages={totalPages} />
    </section>
    <SiteRail posts={allPosts} tags={tags} />
  </div>
</BaseLayout>
