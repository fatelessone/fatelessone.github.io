---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Fatelessone 的个人博客' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container" aria-label="主导航">
        <a class="brand" href="/">
          <img class="brand-avatar" src="/avatar.jpg" alt="Fatelessone 的头像" width="40" height="40" />
          <span>Fatelessone</span>
        </a>
        <div class="nav-links">
          <a href="/">文章</a>
          <a href="/tags">标签</a>
          <a href="/about">关于</a>
        </div>
      </nav>
    </header>
    <main class="site-main container"><slot /></main>
    <footer class="site-footer container">
      <small>© {new Date().getFullYear()} Fatelessone. Built with Astro.</small>
    </footer>
  </body>
</html>
